{
  "name": "a2g",
  "version": "1.0.0",
  "license": "MIT",
  "description": "",
  "scripts": {
    "build": "npm run js-build && npm run sass && eleventy",
    "watch": "concurrently \"eleventy --serve\" \"npm run js-build-watch\" \"npm run sass-watch\"",
    "serve": "eleventy --serve",
    "js-build": "rollup -c rollup.config.mjs",
    "js-build-watch": "rollup -c rollup.config.mjs -w",
    "debug": "DEBUG=* eleventy",
    "sass": "sass scss/main.scss css/main.css",
    "sass-watch": "npm run sass -- --watch",
    "prepare": "husky",
    "update-bahunya": "node scripts/update-bahunya.mjs"
  },
  "author": "Allan Jones",
  "repository": {
    "type": "git",
    "url": "https://github.com/blades/Allergic2Gardening/"
  },
  "bugs": {
    "url": "https://github.com/blades/Allergic2Gardening/issues"
  },
  "homepage": "https://github.com/blades/Allergic2Gardening/#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "eleventy-plugin-local-images": "^0.4.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0"
  },
  "dependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "any-shell-escape": "^0.1.1",
    "concurrently": "^10.0.6",
    "csso": "^5.0.5",
    "debug": "^4.4.3",
    "elasticlunr": "^0.9.5",
    "eleventy-plugin-embed-instagram": "^1.3.1",
    "eleventy-plugin-embed-twitter": "^1.4.4",
    "ffmpeg-static": "^5.3.0",
    "htmlnano": "^3.5.1",
    "image-size": "^2.0.4",
    "purgecss": "^8.0.0",
    "rollup": "^4.64.3",
    "sass": "^1.105.1",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "eleventy-plugin-local-images": {
      "jsdom": "$jsdom"
    }
  },
  "allowScripts": {
    "ffmpeg-static": true,
    "@parcel/watcher": false
  }
}
